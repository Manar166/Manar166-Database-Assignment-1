        <mxCell id="kNs-N5z3p6FgXOhfeEgP-53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#F1F6FA;fontColor=#183153;fontSize=13;" value="Each vehicle status change must record who changed it and when." vertex="1">
          <mxGeometry height="63" width="440" x="167" y="-435" as="geometry" />
        </mxCell>
        <mxCell id="kNs-N5z3p6FgXOhfeEgP-54" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#F1F6FA;fontColor=#183153;fontSize=13;" value="Constraints cannot automatically create a new audit record for a status update." vertex="1">
