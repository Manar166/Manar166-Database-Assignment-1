        <mxCell id="kNs-N5z3p6FgXOhfeEgP-56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#FFFFFF;fontColor=#183153;fontSize=13;fontStyle=1;" value="4" vertex="1">
