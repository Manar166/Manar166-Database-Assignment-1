        </mxCell>
        <mxCell id="kNs-N5z3p6FgXOhfeEgP-55" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#F1F6FA;fontColor=#183153;fontSize=13;" value="Stored procedure that changes status and inserts an audit entry atomically." vertex="1">
          <mxGeometry height="63" width="425" x="1072" y="-435" as="geometry" />
