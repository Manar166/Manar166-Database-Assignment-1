        </mxCell>
        <mxCell id="kNs-N5z3p6FgXOhfeEgP-57" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#FFFFFF;fontColor=#183153;fontSize=13;" value="§7.6, §8" vertex="1">
          <mxGeometry height="63" width="105" x="62" y="-372" as="geometry" />
        </mxCell>
        <mxCell id="kNs-N5z3p6FgXOhfeEgP-58" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#FFFFFF;fontColor=#183153;fontSize=13;" value="A transfer must originate from the vehicle’s actual current branch." vertex="1">
          <mxGeometry height="63" width="440" x="167" y="-372" as="geometry" />
        </mxCell>
        <mxCell id="kNs-N5z3p6FgXOhfeEgP-59" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#FFFFFF;fontColor=#183153;fontSize=13;" value="The source branch must be validated against the vehicle’s current location or movement history." vertex="1">
          <mxGeometry height="63" width="465" x="607" y="-372" as="geometry" />
