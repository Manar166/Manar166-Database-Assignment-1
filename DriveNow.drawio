        <mxCell id="kNs-N5z3p6FgXOhfeEgP-43" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=6;spacingBottom=6;strokeColor=#C8D3DF;strokeWidth=1;fillColor=#F1F6FA;fontColor=#183153;fontSize=13;" value="Every training attempt must be preserved, including repeated attempts." vertex="1">
